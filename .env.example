# ─── Supabase ────────────────────────────────────────────────
# Supabase 프로젝트 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 절대 클라이언트로 노출하지 말 것. Route Handler / Python 배치 전용
SUPABASE_SERVICE_ROLE_KEY=

# ─── 네이버 뉴스 검색 API ─────────────────────────────────────
# NAVER API HUB 콘솔 > 애플리케이션 등록 > 검색 API > 인증정보의 Client ID / Client Secret
# (계정 IAM 액세스 키 `ncp_iam_…` 가 아니다)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── OpenDART ────────────────────────────────────────────────
# https://opendart.fss.or.kr/  인증키 신청 (일 20,000콜)
OPENDART_API_KEY=

# ─── LLM ─────────────────────────────────────────────────────
# anthropic | openai | gemini
#
# gemini 는 AI Studio 무료 티어라 카드 등록이 필요 없고, 임베딩까지 Gemini 가
# 처리하므로 키 하나로 전부 돌아간다. 무료 티어의 제약은 금액이 아니라 요청 수라
# 한도를 넘기면 과금이 아니라 429 가 온다.
LLM_PROVIDER=gemini
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# LLM_PROVIDER 가 anthropic 일 때 임베딩용으로도 쓰인다 (Anthropic 임베딩 API 없음)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── 운영 ────────────────────────────────────────────────────
# cron 엔드포인트 인증용. openssl rand -hex 32 등으로 생성
CRON_SECRET=
# 최초 관리자 계정 이메일
ADMIN_EMAIL=
