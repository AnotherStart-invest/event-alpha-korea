# ─── Supabase ────────────────────────────────────────────────
# Supabase 프로젝트 > Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 절대 클라이언트로 노출하지 말 것. Route Handler / Python 배치 전용
SUPABASE_SERVICE_ROLE_KEY=

# ─── 네이버 뉴스 검색 API ─────────────────────────────────────
# https://developers.naver.com/apps  > 검색 API 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ─── OpenDART ────────────────────────────────────────────────
# https://opendart.fss.or.kr/  인증키 신청 (일 20,000콜)
OPENDART_API_KEY=

# ─── LLM ─────────────────────────────────────────────────────
# anthropic | openai
LLM_PROVIDER=anthropic
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── 운영 ────────────────────────────────────────────────────
# cron 엔드포인트 인증용. openssl rand -hex 32 등으로 생성
CRON_SECRET=
# 최초 관리자 계정 이메일
ADMIN_EMAIL=
